# Database (Supabase PostgreSQL)
DATABASE_URL="postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres"

# Supabase
NEXT_PUBLIC_SUPABASE_URL="https://xxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Telegram Bot API
TELEGRAM_BOT_TOKEN="your-telegram-bot-token"
TELEGRAM_CHANNELS="ClashReport"

# OpenAI API (for article generation)
OPENAI_API_KEY="sk-..."
OPENAI_MODEL="gpt-4o"

# Admin Auth
ADMIN_JWT_SECRET="generate-a-random-secret-at-least-32-chars"
ADMIN_DEFAULT_EMAIL="admin@raporti.info"
ADMIN_DEFAULT_PASSWORD="change-this-password"

# Site Config
NEXT_PUBLIC_SITE_URL="https://raporti.info"
NEXT_PUBLIC_SITE_NAME="Raporti"

# Cron Security
CRON_SECRET="generate-a-random-cron-secret"

# Image Mode: generated | source-link | admin-approved
DEFAULT_IMAGE_MODE="generated"

# Publishing Mode: manual | auto
DEFAULT_PUBLISH_MODE="manual"
